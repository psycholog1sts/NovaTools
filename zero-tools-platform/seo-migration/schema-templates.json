      "width": 512,
      "height": 512
    },
    "sameAs": [
      "https://github.com/zero-tools"
    ],
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "hello@zerotools.dev",
      "contactType": "customer support",
      "availableLanguage": ["Turkish", "English"]
    }
  },

