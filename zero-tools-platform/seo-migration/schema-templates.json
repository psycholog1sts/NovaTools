{
  "$comment": "JSON-LD Schema Templates for ZeroTools Platform",
  "$schema": "http://json-schema.org/draft-07/schema#",
  
  "WebSite": {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "ZeroTools",
    "url": "https://zerotools.dev",
    "description": "Privacy-first online tools platform. Zero server, zero data transmission.",
    "inLanguage": ["tr", "en"],
    "publisher": {
      "@type": "Organization",
      "name": "ZeroTools Platform",
      "logo": {
        "@type": "ImageObject",
        "url": "https://zerotools.dev/logo.svg",
        "width": 512,
        "height": 512
      }
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://zerotools.dev/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  },

  "Organization": {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "ZeroTools Platform",
    "alternateName": "ZeroTools",
