  "FAQPage_Mortgage": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Konut kredisi hesaplaması nasıl yapılır?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Konut kredisi hesaplaması için kredi tutarı, vade ve faiz oranı bilgileri gereklidir. Aracımızda bu değerleri girerek anında sonuç alabilirsiniz."
        }
      },
      {
        "@type": "Question",
        "name": "KKDF ve BSMV nedir?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "KKDF (Kaynak Kullanımını Destekleme Fonu) %15 ve BSMV (Bankacılık ve Sigortacılık İşlemleri Vergisi) %5 oranında uygulanır."
        }
      },
      {
        "@type": "Question",
        "name": "Verilerim güvende mi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, tüm hesaplamalar tarayıcınızda yapılır. Hiçbir veri sunucularımıza gönderilmez. Zero Server prensibiyle çalışıyoruz."
        }
      }
    ]
  },

  "FAQPage_PDFMerge": {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "PDF birleştirme güvenli mi?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, tamamen güvenli. Tüm işlemler tarayıcınızda gerçekleşir. Dosyalarınız hiçbir zaman sunucularımıza yüklenmez."
        }
      },
      {
        "@type": "Question",
        "name": "En fazla kaç PDF birleştirebilirim?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Tek seferde en fazla 20 PDF dosyasını birleştirebilirsiniz. Toplam dosya boyutu 50MB'ı geçemez."
        }
      },
      {
        "@type": "Question",
        "name": "Form içeren PDF'leri birleştirebilir miyim?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Evet, form alanları ve etkileşimli içerikler korunarak birleştirilir."
        }
      }
    ]
  },

  "HowTo_Mortgage": {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "Konut Kredisi Nasıl Hesaplanır?",
    "description": "Adım adım konut kredisi hesaplama rehberi",
    "totalTime": "PT2M",
    "estimatedCost": {
      "@type": "MonetaryAmount",
      "currency": "TRY",
      "value": "0"
    },
    "supply": [
      {
        "@type": "HowToSupply",
        "name": "Kredi Tutarı"
      },
      {
        "@type": "HowToSupply",
        "name": "Vade (Ay)"
      },
      {
        "@type": "HowToSupply",
        "name": "Faiz Oranı"
      }
    ],
    "tool": {
      "@type": "HowToTool",
      "name": "Konut Kredisi Hesaplama Aracı"
    },
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Kredi Tutarını Girin",
        "text": "Çekmek istediğiniz konut kredisi tutarını girin (örn: 500.000 TL)",
        "url": "https://zerotools.dev/src/tools/finance/mortgage-tr/#step1"
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Vade Seçin",
        "text": "Kredi vadesini ay olarak girin (12-360 ay arası)",
        "url": "https://zerotools.dev/src/tools/finance/mortgage-tr/#step2"
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "Faiz Oranını Girin",
        "text": "Bankanın sunduğu yıllık faiz oranını girin (örn: %12.5)",
        "url": "https://zerotools.dev/src/tools/finance/mortgage-tr/#step3"
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Sonuçları Görüntüleyin",
        "text": "Aylık taksit, toplam ödeme ve faiz tutarını görüntüleyin",
        "url": "https://zerotools.dev/src/tools/finance/mortgage-tr/#step4"
      }
    ]
  },

