# Optional Google Search Console verification token for root index.html.
# Leave blank to omit the meta tag without Vite HTML env warnings.
VITE_GOOGLE_SITE_VERIFICATION=

# Google AdSense Publisher ID
# Get yours at https://www.google.com/adsense/
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Optional Vite dev-server CORS allowlist (comma-separated origins).
# Do not use "*" for production-like development.
VITE_DEV_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
