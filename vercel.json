{
  "version": 2,
  "name": "novatools-mc",
  
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],

  "rewrites": [
    { "source": "/tools/finance/mortgage-refinance", "destination": "/src/tools/finance/mortgage-refinance/index.html" },
    { "source": "/tools/finance/compound-interest", "destination": "/src/tools/finance/compound-interest/index.html" },
    { "source": "/tools/finance/cloud-cost", "destination": "/src/tools/finance/cloud-cost/index.html" },
    { "source": "/tools/finance/crypto-tax", "destination": "/src/tools/finance/crypto-tax/index.html" },
    { "source": "/tools/finance/life-insurance", "destination": "/src/tools/finance/life-insurance/index.html" },
    { "source": "/tools/finance/student-loan", "destination": "/src/tools/finance/student-loan/index.html" },
    { "source": "/tools/finance/retirement", "destination": "/src/tools/finance/retirement/index.html" },
    { "source": "/tools/finance/tax", "destination": "/src/tools/finance/tax/index.html" },
    { "source": "/tools/pdf/merge", "destination": "/src/tools/pdf/merge/index.html" },
    { "source": "/tools/pdf/compress", "destination": "/src/tools/pdf/compress/index.html" },
    { "source": "/tools/pdf/split", "destination": "/src/tools/pdf/split/index.html" },
    { "source": "/tools/image/compress", "destination": "/src/tools/image/compress/index.html" },
    { "source": "/tools/image/convert", "destination": "/src/tools/image/convert/index.html" },
    { "source": "/tools/religious/islamic-calendar", "destination": "/src/tools/religious/islamic-calendar/index.html" },
    { "source": "/tools/news/summarizer", "destination": "/src/tools/news/summarizer/index.html" },
    { "source": "/tools/(.*)", "destination": "/src/tools/$1" },
    { "source": "/blog/(.*)", "destination": "/src/blog/$1" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/(.*\\.xml)$",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
