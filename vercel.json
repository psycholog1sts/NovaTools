{
  "version": 2,
  "name": "novatools-mc",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  
  "rewrites": [
    { "source": "/tools/finance/mortgage-refinance", "destination": "/src/tools/finance/mortgage-refinance" },
    { "source": "/tools/finance/compound-interest", "destination": "/src/tools/finance/compound-interest" },
    { "source": "/tools/finance/cloud-cost", "destination": "/src/tools/finance/cloud-cost" },
    { "source": "/tools/finance/crypto-tax", "destination": "/src/tools/finance/crypto-tax" },
    { "source": "/tools/finance/life-insurance", "destination": "/src/tools/finance/life-insurance" },
    { "source": "/tools/finance/student-loan", "destination": "/src/tools/finance/student-loan" },
    { "source": "/tools/finance/retirement", "destination": "/src/tools/finance/retirement" },
    { "source": "/tools/finance/tax", "destination": "/src/tools/finance/tax" },
    { "source": "/tools/pdf/merge", "destination": "/src/tools/pdf/merge" },
    { "source": "/tools/pdf/compress", "destination": "/src/tools/pdf/compress" },
    { "source": "/tools/pdf/split", "destination": "/src/tools/pdf/split" },
    { "source": "/tools/image/compress", "destination": "/src/tools/image/compress" },
    { "source": "/tools/image/convert", "destination": "/src/tools/image/convert" },
    { "source": "/tools/religious/islamic-calendar", "destination": "/src/tools/religious/islamic-calendar" },
    { "source": "/tools/news/summarizer", "destination": "/src/tools/news/summarizer" }
  ],

  "headers": [
    {
      "source": "/(.*\\.js)$",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.css)$",
      "headers": [
        { "key": "Content-Type", "value": "text/css; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
