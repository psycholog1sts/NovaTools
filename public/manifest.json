{
  "name": "MC NovaTools - Privacy-First Utility Tools",
  "short_name": "MC NovaTools",
  "description": "Privacy-first browser tools for PDF, image, finance, developer, and productivity workflows.",
  "start_url": "/?source=pwa",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F8F9FA",
  "theme_color": "#0A0A0C",
  "categories": [
    "finance",
    "utilities",
    "productivity",
    "developer"
  ],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Mortgage Refinance",
      "short_name": "Mortgage",
      "description": "Calculate mortgage refinance savings",
      "url": "/tools/finance/mortgage-refinance/",
      "icons": [
        {
          "src": "/icons/finance-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Life Insurance",
      "short_name": "Insurance",
      "description": "Estimate life insurance payouts",
      "url": "/tools/finance/life-insurance/",
      "icons": [
        {
          "src": "/icons/finance-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "PDF Merger",
      "short_name": "PDF Merge",
      "description": "Merge PDF files",
      "url": "/tools/pdf/merge/",
      "icons": [
        {
          "src": "/icons/pdf-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/tools/pdf/merge/?share-target=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "pdfFiles",
          "accept": [
            "application/pdf",
            "image/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/tools/pdf/merge/?file-handler=true",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      }
    },
    {
      "action": "/tools/image/compress/?file-handler=true",
      "accept": {
        "image/*": [
          ".png",
          ".jpg",
          ".jpeg",
          ".webp"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+pdfmerge",
      "url": "/tools/pdf/merge/?source=%s"
    },
    {
      "protocol": "web+pdfcompress",
      "url": "/tools/pdf/compress/?source=%s"
    },
    {
      "protocol": "web+mortgage",
      "url": "/tools/finance/mortgage-refinance/?source=%s"
    }
  ],
  "scope": "/"
}
