# NOTE: root-level pages (about-us, contact, request-tool, privacy-policy,
# terms-of-service, disclaimer, cookie-policy, security, gizlilik-politikasi,
# kvkk-aydinlatma-metni, kullanim-kosullari, iletisim) intentionally have NO
# clean-URL rewrite rule here. Cloudflare Pages already serves `/about-us`
# from `about-us.html` natively, and already 308-redirects `/about-us.html`
# to `/about-us`. A custom rule rewriting the clean path back to the same
# `.html` file collides with that native handling and produces an infinite
# self-redirect (`/about-us` -> 308 -> `/about-us`), which is exactly the
# 404/redirect-loop bug reported on these pages in production. Do not
# reintroduce a `/<page> /<page>.html 200` rule for a page that already has
# a same-named `.html` file — see tests/site-regressions.mjs for the guard.

# The old /tools/request/ route contains an unconfigured Formspree placeholder.
# Canonicalize it to the honest mailto-based request page instead of exposing
# a form that cannot submit successfully.
/tools/request /request-tool.html 301
/tools/request/ /request-tool.html 301

# Legacy source-tree tool URLs must never render the 404 shell.
# Preserve the complete tool suffix and move users to the canonical public namespace.
/src/tools/* /tools/:splat 301

# NOTE: category, blog, and guides clean URLs are likewise handled by
# Cloudflare's native `.html`-stripping behavior and intentionally have no
# rewrite rule here, for the same self-redirect-loop reason described above.

# Legacy locale-folder URLs are redirected to the canonical ?lang= locale standard.
/de /?lang=de 301
/de/* /:splat?lang=de 301
/fr /?lang=fr 301
/fr/* /:splat?lang=fr 301
/es /?lang=es 301
/es/* /:splat?lang=es 301
/pt /?lang=pt 301
/pt/* /:splat?lang=pt 301
/ru /?lang=ru 301
/ru/* /:splat?lang=ru 301
/zh /?lang=zh 301
/zh/* /:splat?lang=zh 301
/ja /?lang=ja 301
/ja/* /:splat?lang=ja 301
/ko /?lang=ko 301
/ko/* /:splat?lang=ko 301
/ar /?lang=ar 301
/ar/* /:splat?lang=ar 301
/hi /?lang=hi 301
/hi/* /:splat?lang=hi 301
/it /?lang=it 301
/it/* /:splat?lang=it 301
/pl /?lang=pl 301
/pl/* /:splat?lang=pl 301
/nl /?lang=nl 301
/nl/* /:splat?lang=nl 301

# Explicit 404 fallback for unmatched static routes.
/* /404.html 404
