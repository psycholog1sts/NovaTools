# Clean URL rewrites for Cloudflare Pages static HTML routes.
/about-us /about-us.html 200
/contact /contact.html 200
/request-tool /request-tool.html 200
/privacy-policy /privacy-policy.html 200
/terms-of-service /terms-of-service.html 200
/disclaimer /disclaimer.html 200
/cookie-policy /cookie-policy.html 200
/security /security.html 200
/gizlilik-politikasi /gizlilik-politikasi.html 200
/kvkk-aydinlatma-metni /kvkk-aydinlatma-metni.html 200
/kullanim-kosullari /kullanim-kosullari.html 200
/iletisim /iletisim.html 200

# The old /tools/request/ route contains an unconfigured Formspree placeholder.
# Canonicalize it to the honest mailto-based request page instead of exposing
# a form that cannot submit successfully.
/tools/request /request-tool.html 301
/tools/request/ /request-tool.html 301

# Legacy source-tree tool URLs must never render the 404 shell.
# Preserve the complete tool suffix and move users to the canonical public namespace.
/src/tools/* /tools/:splat 301

# Category and blog clean URL rewrites.
/categories/:page /categories/:page.html 200
/blog/categories/:page /blog/categories/:page.html 200
/blog/articles/:article /blog/articles/:article.html 200

# Topical authority clean URL rewrites.
/guides/complete-pdf-workflow /guides/complete-pdf-workflow.html 200
/guides/web-image-optimization /guides/web-image-optimization.html 200
/guides/developer-productivity-tools /guides/developer-productivity-tools.html 200
/guides/personal-finance-calculations /guides/personal-finance-calculations.html 200
/guides/articles/:article /guides/articles/:article.html 200
/site-map/topical /site-map/topical.html 200

# Unsupported legacy locale-folder URLs fall back to the equivalent clean
# English route instead of creating query-locale URLs that the runtime does
# not support. Preserve the suffix so valid tools/articles keep their target.
/de / 301
/de/* /:splat 301
/fr / 301
/fr/* /:splat 301
/es / 301
/es/* /:splat 301
/pt / 301
/pt/* /:splat 301
/ru / 301
/ru/* /:splat 301
/zh / 301
/zh/* /:splat 301
/ja / 301
/ja/* /:splat 301
/ko / 301
/ko/* /:splat 301
/hi / 301
/hi/* /:splat 301
/it / 301
/it/* /:splat 301
/pl / 301
/pl/* /:splat 301
/nl / 301
/nl/* /:splat 301

# Arabic blog pages have dedicated content manifests and built routes, so no
# blanket /ar redirect is declared here. This prevents a valid Arabic article
# from being intercepted before Cloudflare Pages can serve its static asset.
# Missing routes are handled natively by Cloudflare Pages using the built 404.html.
