# Dependencies
node_modules/
.pnpm-store/
# Platform-specific installs must never be committed: a Windows-built
# node_modules breaks Linux CI (missing @rollup/rollup-linux-x64-gnu, sharp).

# Python environments
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
# dist/ is produced by `npm run build` and deployed straight from CI
# (see .github/workflows/deploy.yml). Committing it let unverified local
# builds reach production, so it is generated, never tracked.
dist/
*.tsbuildinfo

# Local wrangler pages dev state/cache
.wrangler/

# Environment
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/
# Playwright run output (traces, screenshots, videos) is per-run evidence,
# uploaded as a CI artifact rather than tracked.
test-results/
playwright-report/
blob-report/

# Lighthouse
.lighthouseci/

# Cache
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Temporary
*.tmp
*.temp
